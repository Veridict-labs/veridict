PORT=3001
WEB_ORIGIN=http://localhost:3000
MCP_PUBLIC_URL=http://localhost:3001/mcp
DATABASE_URL=postgresql://veridict:veridict_dev@localhost:5432/veridict

# Primary runtime. Keep credentials in apps/api/.env only, never NEXT_PUBLIC_*.
# Use a Free Tier project with active quota when avoiding paid API usage.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional provider: select AI_PROVIDER=huggingface explicitly. No automatic fallback.
# Hosted inference requires active credits; model access/provider support varies.
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Optional: explicitly bill an HF organization/resource group you are authorized to use.
HF_BILL_TO=
