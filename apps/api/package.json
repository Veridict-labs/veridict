{
  "name": "@veridict/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "predev": "npm run build -w @veridict/contracts && npm run build -w @veridict/agent && prisma generate",
    "prebuild": "npm run build -w @veridict/contracts && npm run build -w @veridict/agent && prisma generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "admin:bootstrap": "node --env-file-if-exists=.env dist/scripts/bootstrap-admin.js",
    "demo:seed": "node --env-file-if-exists=.env dist/scripts/seed-demo.js",
    "test:hf:live": "npm run build && node --env-file-if-exists=.env test/hf-live.cjs",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.cjs"
  },
  "dependencies": {
    "@veridict/agent": "*",
    "@veridict/contracts": "*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "11.0.24",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/express": "^5.0.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prisma": "7.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
